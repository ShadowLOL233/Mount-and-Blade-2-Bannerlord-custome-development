<CheatsGuard>
  <VerboseLog>true</VerboseLog>

  <!-- Round 1: 启用非 skip 的 patch · 观察 Campaign 是否稳 -->
  <SkipAllCheatsPatches>false</SkipAllCheatsPatches>

  <!-- ============================================================ -->
  <!-- ⚠⚠⚠ 危险 · 永远保持 false ⚠⚠⚠                                 -->
  <!-- CheatsGuard 的 NativeItemSpawningReplacement · Cheats 原版逻辑 -->
  <!-- 打开背包时把 ObjectManager 里全部 ItemObject 塞进 leftItemRoster -->
  <!--                                                                -->
  <!-- 若在 vanilla town/castle 打开 stash 时启用：                   -->
  <!--   leftItemRoster == Settlement.Stash (持久对象 · 序列化存档)   -->
  <!--   → 每次打开都往存档塞几千种 item × count 份                    -->
  <!--   → save 文件肿胀 · EquipmentSpawnerMod 的 OSA 生态被污染      -->
  <!--   → culture 过滤 + tier sort 全失效 · UI 卡崩                  -->
  <!--                                                                -->
  <!-- 想刷钱/物：用 vanilla `Ctrl+~` 控制台 · 或 Cheats 加钱热键     -->
  <!-- ============================================================ -->
  <EnableNativeItemSpawning>false</EnableNativeItemSpawning>
  <NativeItemSpawnCount>1</NativeItemSpawnCount>

  <!-- ============================================================ -->
  <!-- 💰 Money hotkey replacement (CheatsGuard 独占)                 -->
  <!-- Cheats 原版 EnableHotkeysMoney 硬编码 1k/100k · 已 skip        -->
  <!-- 在背包 UI 里：Ctrl+X = Small · Ctrl+Shift+X = Large            -->
  <!-- 仍需 Cheats MCM 里 "Enable Hotkeys" 打勾（Global 或 PerCampaign）-->
  <!-- ============================================================ -->
  <EnableMoneyHotkey>true</EnableMoneyHotkey>
  <CheatsMoneySmall>10000000</CheatsMoneySmall>       <!-- Ctrl+X       · 10M -->
  <CheatsMoneyLarge>100000000</CheatsMoneyLarge>      <!-- Ctrl+Shift+X · 100M -->
  <ShowMoneyHotkeyTip>true</ShowMoneyHotkeyTip>       <!-- 每次打开背包 UI 弹一次热键提示 -->

  <!-- ============================================================ -->
  <!-- 🛡 RBM Troop Maintenance (player clan only!)                   -->
  <!-- 由 MaintenancePlayerScopePatch 逐 call swap RBMConfig · 只对   -->
  <!-- 玩家 clan 生效 · 其他 NPC clan 保持 RBM 自己 config.xml 的值    -->
  <!-- MCM 里改这三个值 · 立即用于下一次玩家 clan finance 结算          -->
  <!-- ============================================================ -->
  <RBMTroopMaintenanceFraction>0.005</RBMTroopMaintenanceFraction>
  <RBMRecruitMaintenanceDays>20</RBMRecruitMaintenanceDays>
  <RBMIndependentPurseFraction>1.0</RBMIndependentPurseFraction>

  <!-- ============================================================ -->
  <!-- 📈 Passive Daily XP (player + companions in main party)        -->
  <!-- 每日给玩家 party 内 hero 每个 skill 加 Amount XP · MCM 里三滑块 -->
  <!-- Amount * 18 skills = 每 hero 每天总获得 XP                       -->
  <!-- ============================================================ -->
  <!-- ⚠ 崩溃隔离测试期间关闭 · Round 5 疑似崩 · 待用户确认 Round 4 base 稳定后再打开 -->
  <EnablePassiveDailyXp>false</EnablePassiveDailyXp>
  <PassiveDailyXpAmount>1000</PassiveDailyXpAmount>
  <PassiveDailyXpIncludeCompanions>true</PassiveDailyXpIncludeCompanions>


