<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7">
      <Children>

        <Widget Id="CBTBEditorPanel"
                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="900" SuggestedHeight="650"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="flat_panel_9">
          <Children>

            <TextWidget Id="CBTBTitle"
                        Text="@Title"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        MarginTop="40"
                        Brush="MPEscapeMenu.Title" />

            <TextWidget Id="CBTBBody"
                        Text="@BodyText"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MarginLeft="60" MarginRight="60" MarginTop="100"
                        Brush="MPEscapeMenu.ButtonText" />

            <ButtonWidget Id="CBTBCloseButton"
                          WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                          VerticalAlignment="Bottom" HorizontalAlignment="Center"
                          MarginBottom="40"
                          Brush="ButtonBrush1"
                          DoNotPassEventsToChildren="true"
                          UpdateChildrenStates="true"
                          Command.Click="ExecuteClose">
              <Children>
                <TextWidget Text="@CloseText"
                            WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MarginLeft="30" MarginRight="30" MarginTop="10" MarginBottom="10"
                            Brush="Popup.Button.Text" />
              </Children>
            </ButtonWidget>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
