<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.85">
      <Children>

        <!-- Fullscreen panel -->
        <Widget Id="CBTBEditorPanel"
                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                MarginLeft="24" MarginRight="24" MarginTop="24" MarginBottom="24"
                Sprite="flat_panel_9">
          <Children>

            <TextWidget Id="CBTBTitle"
                        Text="@Title"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        MarginTop="30"
                        Brush="MPEscapeMenu.Title" />

            <!-- Search row -->
            <Widget Id="CBTBSearchRow"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="46"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    MarginTop="100" MarginLeft="60" MarginRight="60">
              <Children>
                <TextWidget Text="@SearchHint"
                            WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="360"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="MPEscapeMenu.ButtonText" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MarginLeft="370" MarginRight="300"
                        Sprite="BlankWhiteSquare_9" Color="#FFFFFF18" AlphaFactor="1.0">
                  <Children>
                    <EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MarginLeft="10" MarginRight="10" MarginTop="6" MarginBottom="6"
                                        Brush="Review.NameInput.Text"
                                        Text="@SearchText" />
                  </Children>
                </Widget>
                <TextWidget Text="@CountText"
                            WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="280"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Brush="MPEscapeMenu.ButtonText" />
              </Children>
            </Widget>

            <!-- Mode row: Combat / All / Civilian -->
            <ListPanel Id="CBTBModeRow"
                       WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                       SuggestedHeight="42"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       MarginTop="160"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget Id="CBTBModeCombat"
                              WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                              SuggestedWidth="170"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              IsSelected="@IsModeCombat" Command.Click="ExecuteSetModeCombat" MarginRight="8">
                  <Children>
                    <TextWidget Text="@ModeCombatText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget Id="CBTBModeAll"
                              WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                              SuggestedWidth="170"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              IsSelected="@IsModeAll" Command.Click="ExecuteSetModeAll" MarginRight="8">
                  <Children>
                    <TextWidget Text="@ModeAllText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget Id="CBTBModeCivilian"
                              WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                              SuggestedWidth="170"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              IsSelected="@IsModeCivilian" Command.Click="ExecuteSetModeCivilian">
                  <Children>
                    <TextWidget Text="@ModeCivilianText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <!-- Main row · Horizontal split: Troop list (left) + Tab panel (right) -->
            <ListPanel Id="CBTBMainRow"
                       WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       MarginTop="220" MarginBottom="110" MarginLeft="60" MarginRight="60"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>

                <!-- Left half · Troop list + scrollbar (Phase 3a-scroll pattern · 保留) -->
                <Widget Id="CBTBListFrame"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        MarginRight="12">
                  <Children>
                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     AutoHideScrollBars="true"
                                     ClipRect="CBTBClipRect"
                                     InnerPanel="CBTBClipRect\CBTBInnerList"
                                     VerticalScrollbar="..\CBTBVerticalScrollbar">
                      <Children>
                        <Widget Id="CBTBClipRect"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                ClipContents="true"
                                Sprite="BlankWhiteSquare_9" Color="#00000040" AlphaFactor="1.0">
                          <Children>
                            <ListPanel Id="CBTBInnerList"
                                       WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       StackLayout.LayoutMethod="VerticalTopToBottom"
                                       DataSource="{Troops}"
                                       MarginLeft="8" MarginRight="22" MarginTop="6" MarginBottom="6">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                              SuggestedHeight="30"
                                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                              IsSelected="@IsSelected" Command.Click="ExecuteSelect">
                                  <Children>
                                    <Widget IsVisible="@IsSelected" DoNotAcceptEvents="true"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Sprite="BlankWhiteSquare_9" Color="#C7AC8577" AlphaFactor="1.0" />
                                    <TextWidget Text="@SummaryLine"
                                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="10"
                                                Brush="MPEscapeMenu.ButtonText"
                                                DoNotAcceptEvents="true" />
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="CBTBVerticalScrollbar"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                     SuggestedWidth="8"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     AlignmentAxis="Vertical"
                                     Handle="CBTBScrollbarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#5A4033FF" AlphaFactor="0.5" />
                        <ImageWidget Id="CBTBScrollbarHandle"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     SuggestedHeight="10" SuggestedWidth="10"
                                     HorizontalAlignment="Center"
                                     Brush="FaceGen.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>

                <!-- Right half · Tab panel (Phase 3d · 4-tab architecture) -->
                <Widget Id="CBTBTabFrame"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        MarginLeft="12"
                        Sprite="BlankWhiteSquare_9" Color="#00000040" AlphaFactor="1.0">
                  <Children>

                    <!-- Tab bar (top · 4 button horizontal) -->
                    <ListPanel Id="CBTBTabBar"
                               WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                               SuggestedHeight="42"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               MarginTop="12" MarginLeft="12" MarginRight="12"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                      Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                      IsSelected="@IsSummaryTab" Command.Click="ExecuteSetTabSummary" MarginRight="4">
                          <Children>
                            <TextWidget Text="@TabSummaryText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                      Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                      IsSelected="@IsEquipmentTab" Command.Click="ExecuteSetTabEquipment" MarginRight="4">
                          <Children>
                            <TextWidget Text="@TabEquipmentText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                      Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                      IsSelected="@IsSkillsTab" Command.Click="ExecuteSetTabSkills" MarginRight="4">
                          <Children>
                            <TextWidget Text="@TabSkillsText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                      Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                      IsSelected="@IsMetaTab" Command.Click="ExecuteSetTabMeta">
                          <Children>
                            <TextWidget Text="@TabMetaText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" />
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>

                    <!-- Tab content area (middle · 4 widget swap by IsVisible) -->
                    <Widget Id="CBTBTabContent"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            MarginTop="66" MarginBottom="12" MarginLeft="12" MarginRight="12">
                      <Children>

                        <!-- Summary tab · Phase 3b-1 preview 保留 -->
                        <Widget Id="CBTBSummaryContent" IsVisible="@IsSummaryTab"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                             AutoHideScrollBars="true"
                                             ClipRect="CBTBSummClipRect"
                                             InnerPanel="CBTBSummClipRect\CBTBSummInnerList"
                                             VerticalScrollbar="..\CBTBSummScrollbar">
                              <Children>
                                <Widget Id="CBTBSummClipRect"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        ClipContents="true">
                                  <Children>
                                    <ListPanel Id="CBTBSummInnerList"
                                               WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               StackLayout.LayoutMethod="VerticalTopToBottom"
                                               MarginLeft="20" MarginRight="30" MarginTop="8" MarginBottom="12">
                                      <Children>
                                        <TextWidget Text="@PreviewHeading"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    MarginBottom="16"
                                                    Brush="MPEscapeMenu.Title" />
                                        <TextWidget Text="@PreviewBody"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Brush="MPEscapeMenu.ButtonText" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </Widget>
                              </Children>
                            </ScrollablePanel>
                            <ScrollbarWidget Id="CBTBSummScrollbar"
                                             WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                             SuggestedWidth="8"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             AlignmentAxis="Vertical"
                                             Handle="CBTBSummScrollbarHandle" MaxValue="100" MinValue="0">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4"
                                        HorizontalAlignment="Center"
                                        Sprite="BlankWhiteSquare_9" Color="#5A4033FF" AlphaFactor="0.5" />
                                <ImageWidget Id="CBTBSummScrollbarHandle"
                                             WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                             SuggestedHeight="10" SuggestedWidth="10"
                                             HorizontalAlignment="Center"
                                             Brush="FaceGen.Scrollbar.Handle" />
                              </Children>
                            </ScrollbarWidget>
                          </Children>
                        </Widget>

                        <!-- Equipment tab · Phase 4a Pending placeholder -->
                        <Widget Id="CBTBEquipmentContent" IsVisible="@IsEquipmentTab"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <TextWidget Text="@EquipmentPendingText"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        MarginTop="30" MarginLeft="30" MarginRight="30"
                                        Brush="MPEscapeMenu.ButtonText" />
                          </Children>
                        </Widget>

                        <!-- Skills tab · Phase 5a Pending placeholder -->
                        <Widget Id="CBTBSkillsContent" IsVisible="@IsSkillsTab"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <TextWidget Text="@SkillsPendingText"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        MarginTop="30" MarginLeft="30" MarginRight="30"
                                        Brush="MPEscapeMenu.ButtonText" />
                          </Children>
                        </Widget>

                        <!-- Meta tab · Phase 5b Pending placeholder -->
                        <Widget Id="CBTBMetaContent" IsVisible="@IsMetaTab"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <TextWidget Text="@MetaPendingText"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        MarginTop="30" MarginLeft="30" MarginRight="30"
                                        Brush="MPEscapeMenu.ButtonText" />
                          </Children>
                        </Widget>

                      </Children>
                    </Widget>

                  </Children>
                </Widget>

              </Children>
            </ListPanel>

            <!-- Bottom bar · Clone + Close 并列 -->
            <ListPanel Id="CBTBBottomBar"
                       WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       MarginBottom="30"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget Id="CBTBCloneButton"
                              WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                              Brush="ButtonBrush1" IsEnabled="@HasSelection"
                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteClone" MarginRight="20">
                  <Children>
                    <TextWidget Text="@CloneText"
                                WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MarginLeft="36" MarginRight="36" MarginTop="12" MarginBottom="12"
                                Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget Id="CBTBCloseButton"
                              WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                              Brush="ButtonBrush1"
                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteClose">
                  <Children>
                    <TextWidget Text="@CloseText"
                                WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MarginLeft="36" MarginRight="36" MarginTop="12" MarginBottom="12"
                                Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
