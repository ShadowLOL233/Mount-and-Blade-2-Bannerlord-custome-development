<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <ButtonWidget Id="CBTBOpenTroopBuilderButton"
                DoNotPassEventsToChildren="true"
                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="!SpectateButton.Width" SuggestedHeight="!SpectateButton.Height"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MarginLeft="40"
                Brush="WideButton.Flat"
                Command.Click="ExecuteOpenTroopBuilder"
                UpdateChildrenStates="true"
                GamepadNavigationIndex="3">
    <Children>
      <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                  MarginTop="10" MarginBottom="10"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="300"
                  Brush="MPTeamSelection.SpectateButton.Text"
                  Text="@TroopBuilderButtonText" />
    </Children>
  </ButtonWidget>
</Prefab>
