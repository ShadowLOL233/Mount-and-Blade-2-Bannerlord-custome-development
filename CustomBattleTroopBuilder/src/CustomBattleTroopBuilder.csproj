<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CustomBattleTroopBuilder</RootNamespace>
    <AssemblyName>CustomBattleTroopBuilder</AssemblyName>
    <Version>0.3.3</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>CustomBattleTroopBuilder</Company>
    <Product>CustomBattleTroopBuilder</Product>
    <AssemblyTitle>Custom Battle Troop Builder (CBTB)</AssemblyTitle>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <GameRoot Condition="'$(GameRoot)' == ''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
    <GameBin>$(GameRoot)\bin\Win64_Shipping_Client</GameBin>
    <WorkshopRoot>E:\SteamLibrary\steamapps\workshop\content\261550</WorkshopRoot>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- TaleWorlds -->
  <ItemGroup>
    <Reference Include="TaleWorlds.Core">            <HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath>                             <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Library">         <HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath>                          <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Engine">          <HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath>                           <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">    <HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath>                     <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.InputSystem">     <HintPath>$(GameBin)\TaleWorlds.InputSystem.dll</HintPath>                      <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Localization">    <HintPath>$(GameBin)\TaleWorlds.Localization.dll</HintPath>                     <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">   <HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath>                    <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.ScreenSystem">    <HintPath>$(GameBin)\TaleWorlds.ScreenSystem.dll</HintPath>                     <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.CustomBattle"> <HintPath>$(GameRoot)\Modules\CustomBattle\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.CustomBattle.dll</HintPath> <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.GauntletUI">       <HintPath>$(GameBin)\TaleWorlds.GauntletUI.dll</HintPath>       <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.TwoDimension">     <HintPath>$(GameBin)\TaleWorlds.TwoDimension.dll</HintPath>     <Private>false</Private> </Reference>
  </ItemGroup>

  <!-- Workshop frameworks -->
  <ItemGroup>
    <Reference Include="0Harmony">             <HintPath>$(WorkshopRoot)\2859188632\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>             <Private>false</Private> </Reference>
    <Reference Include="Bannerlord.ButterLib"> <HintPath>$(WorkshopRoot)\2859232415\bin\Win64_Shipping_Client\Bannerlord.ButterLib.dll</HintPath> <Private>false</Private> </Reference>
    <Reference Include="Bannerlord.UIExtenderEx"> <HintPath>$(WorkshopRoot)\2859222409\bin\Win64_Shipping_Client\Bannerlord.UIExtenderEx.dll</HintPath> <Private>false</Private> </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

</Project>
