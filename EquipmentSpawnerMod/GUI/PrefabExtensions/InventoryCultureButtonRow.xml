<!-- 6-culture button row, injected at the top of the left ("Other") inventory panel wrapper.
     Buttons are 45x36 with 3-letter abbreviations (Emp/Vla/Ase/Bat/Stu/Khu) to fit the narrow
     side-panel width (~SidePanel.Width). Total row width 6 x 45 = 270px. Row height 40. -->
<ListPanel Id="EqsmCultureFilterRow"
           WidthSizePolicy="CoverChildren"
           HeightSizePolicy="Fixed"
           SuggestedHeight="40"
           HorizontalAlignment="Center"
           MarginTop="2"
           MarginBottom="2"
           StackLayout.LayoutMethod="HorizontalLeftToRight">
  <Children>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureEmpire"
                      IsSelected="@EqsmCultureEmpireSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Emp"/>
      </Children>
    </SortButtonWidget>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureVlandia"
                      IsSelected="@EqsmCultureVlandiaSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Vla"/>
      </Children>
    </SortButtonWidget>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureAserai"
                      IsSelected="@EqsmCultureAseraiSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Ase"/>
      </Children>
    </SortButtonWidget>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureBattania"
                      IsSelected="@EqsmCultureBattaniaSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Bat"/>
      </Children>
    </SortButtonWidget>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureSturgia"
                      IsSelected="@EqsmCultureSturgiaSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Stu"/>
      </Children>
    </SortButtonWidget>
    <SortButtonWidget DoNotPassEventsToChildren="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="45" SuggestedHeight="36"
                      Brush="Clan.Members.Sort.1"
                      Command.Click="ExecuteEqsmSelectCultureKhuzait"
                      IsSelected="@EqsmCultureKhuzaitSelected"
                      UpdateChildrenStates="true">
      <Children>
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Brush="Clan.LeftPanel.Header.Text" Text="Khu"/>
      </Children>
    </SortButtonWidget>
  </Children>
</ListPanel>
