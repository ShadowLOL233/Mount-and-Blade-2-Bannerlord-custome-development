    <Reference Include="TaleWorlds.GauntletUI.ExtraWidgets">          <HintPath>$(GameBin)\TaleWorlds.GauntletUI.ExtraWidgets.dll</HintPath>           <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI">                <HintPath>$(GameBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath>                 <Private>false</Private> </Reference>
