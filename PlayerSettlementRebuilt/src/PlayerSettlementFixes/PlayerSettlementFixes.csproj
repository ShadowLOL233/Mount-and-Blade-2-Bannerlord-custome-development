<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PlayerSettlementFixes</RootNamespace>
    <AssemblyName>PlayerSettlementFixes</AssemblyName>
    <Version>1.0.1</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>PlayerSettlement</Company>
    <Product>PlayerSettlementFixes</Product>
    <AssemblyTitle>PlayerSettlementFixes (Rebuilt)</AssemblyTitle>
    <Configurations>Debug;Release</Configurations>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ErrorReport>none</ErrorReport>

    <GameRoot Condition="'$(GameRoot)' == ''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
    <GameBin>$(GameRoot)\bin\Win64_Shipping_Client</GameBin>
    <WorkshopRoot>E:\SteamLibrary\steamapps\workshop\content\261550</WorkshopRoot>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CS8632;CS8714;CS8767;CS0168;CS0219;CS0162;CS0414;CS0649;CS0108;CS0169;CS8509;CS8603</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.Core">            <HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath>                             <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Library">         <HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath>                          <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.Engine">          <HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath>                           <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">    <HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath>                     <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">   <HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath>                    <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.Helpers"> <HintPath>$(GameBin)\TaleWorlds.MountAndBlade.Helpers.dll</HintPath>       <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.CampaignSystem"> <HintPath>$(GameBin)\TaleWorlds.CampaignSystem.dll</HintPath>                    <Private>false</Private> </Reference>
    <Reference Include="TaleWorlds.DotNet">          <HintPath>$(GameBin)\TaleWorlds.DotNet.dll</HintPath>                            <Private>false</Private> </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">                   <HintPath>$(WorkshopRoot)\2859188632\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>                   <Private>false</Private> </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

</Project>
